# The public URL the game is served from. It is stamped into the canonical
# link, the Open Graph tags, the JSON-LD, robots.txt, the sitemap and llms.txt.
#
# This file only covers local builds. The deployed value comes from
# VITE_SITE_URL in render.yaml — change it there, not here.
VITE_SITE_URL=https://guessrack.onrender.com
